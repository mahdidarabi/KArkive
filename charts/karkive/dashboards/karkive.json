{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "CRs whose last finished Job failed.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Last job failed",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(count(karkive_backup_last_job_info{namespace=~\"$namespace\",engine=~\"$engine\",outcome=\"Failed\"}) or vector(0)) + (count(karkive_restore_last_job_info{namespace=~\"$namespace\",engine=~\"$engine\",outcome=\"Failed\"}) or vector(0))",
          "legendFormat": "failed",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Owned resources not Ready. This is not last Job success.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 16,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Not ready",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(count(karkive_backup_ready{namespace=~\"$namespace\",engine=~\"$engine\"} == 0) or vector(0)) + (count(karkive_restore_ready{namespace=~\"$namespace\",engine=~\"$engine\"} == 0) or vector(0))",
          "legendFormat": "not ready",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Non-suspended Backups with no success in 36h (default stale alert).",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 17,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Stale backups",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count((time() - karkive_backup_last_successful_timestamp_seconds{namespace=~\"$namespace\",engine=~\"$engine\"} > 129600) and on(namespace,name,engine) (karkive_backup_suspended{namespace=~\"$namespace\",engine=~\"$engine\"} == 0)) or vector(0)",
          "legendFormat": "stale",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "CRs whose last finished Job succeeded.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Last job succeeded",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(count(karkive_backup_last_job_info{namespace=~\"$namespace\",engine=~\"$engine\",outcome=\"Succeeded\"}) or vector(0)) + (count(karkive_restore_last_job_info{namespace=~\"$namespace\",engine=~\"$engine\",outcome=\"Succeeded\"}) or vector(0))",
          "legendFormat": "succeeded",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "orange", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 9,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Suspended",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(sum(karkive_backup_suspended{namespace=~\"$namespace\",engine=~\"$engine\"}) or vector(0)) + (sum(karkive_restore_suspended{namespace=~\"$namespace\",engine=~\"$engine\"}) or vector(0))",
          "legendFormat": "suspended",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Oldest last-success among non-suspended Backups. Orange after 8h, red after 36h.",
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 28800 }, { "color": "red", "value": 129600 }] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Oldest backup success",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max((time() - karkive_backup_last_successful_timestamp_seconds{namespace=~\"$namespace\",engine=~\"$engine\"}) and on(namespace,name,engine) (karkive_backup_suspended{namespace=~\"$namespace\",engine=~\"$engine\"} == 0)) or vector(0)",
          "legendFormat": "age",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Ready means owned resources are synced.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 5 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Backups ready",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(karkive_backup_ready{namespace=~\"$namespace\",engine=~\"$engine\"}) or vector(0)",
          "legendFormat": "ready",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(karkive_backup_ready{namespace=~\"$namespace\",engine=~\"$engine\"}) or vector(0)",
          "legendFormat": "total",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Ready means owned resources are synced.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 5 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Restores ready",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(karkive_restore_ready{namespace=~\"$namespace\",engine=~\"$engine\"}) or vector(0)",
          "legendFormat": "ready",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(karkive_restore_ready{namespace=~\"$namespace\",engine=~\"$engine\"}) or vector(0)",
          "legendFormat": "total",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Last finished Job per CR. Green is Succeeded, red is Failed. CRs with no finished Job are omitted.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "fillOpacity": 80, "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 0 },
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "index": 0, "text": "Succeeded" },
                "1": { "color": "red", "index": 1, "text": "Failed" }
              },
              "type": "value"
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 5 },
      "id": 13,
      "options": { "alignValue": "center", "legend": { "displayMode": "hidden", "placement": "bottom", "showLegend": false }, "mergeValues": true, "rowHeight": 0.8, "showValue": "never", "tooltip": { "mode": "single" } },
      "title": "Last job over time",
      "type": "state-timeline",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(karkive_backup_last_job_failed{namespace=~\"$namespace\",engine=~\"$engine\"} and on(namespace,name,engine) karkive_backup_last_job_info, \"kind\", \"Backup\", \"\", \"\")",
          "legendFormat": "{{kind}} {{namespace}}/{{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(karkive_restore_last_job_failed{namespace=~\"$namespace\",engine=~\"$engine\"} and on(namespace,name,engine) karkive_restore_last_job_info, \"kind\", \"Restore\", \"\", \"\")",
          "legendFormat": "{{kind}} {{namespace}}/{{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Jobs",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Last finished Job for each Backup and Restore.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true, "inspect": false },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Outcome" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "mode": "basic", "type": "color-background" } },
              { "id": "custom.width", "value": 120 },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "Failed": { "color": "red", "index": 0, "text": "Failed" },
                      "Succeeded": { "color": "green", "index": 1, "text": "Succeeded" },
                      "Unknown": { "color": "orange", "index": 2, "text": "Unknown" }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 0 }, { "id": "custom.width", "value": 110 }]
          },
          {
            "matcher": { "id": "byName", "options": "Success age" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 130 },
              { "id": "custom.cellOptions", "value": { "mode": "basic", "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 28800 }, { "color": "red", "value": 129600 }] } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Kind" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "Engine" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 18, "x": 0, "y": 10 },
      "id": 7,
      "options": { "cellHeight": "sm", "footer": { "countRows": true, "fields": "", "reducer": ["count"], "show": true }, "showHeader": true, "sortBy": [{ "desc": false, "displayName": "Outcome" }] },
      "title": "Last job",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true
            },
            "indexByName": {
              "kind": 0,
              "namespace": 1,
              "name": 2,
              "engine": 3,
              "outcome": 4,
              "reason": 5,
              "job_name": 6,
              "Value #A": 7,
              "Value #B": 8
            },
            "renameByName": {
              "kind": "Kind",
              "namespace": "Namespace",
              "name": "Name",
              "engine": "Engine",
              "outcome": "Outcome",
              "reason": "Reason",
              "job_name": "Job",
              "Value #A": "Duration",
              "Value #B": "Success age"
            }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "desc": false, "field": "Outcome" }] } }
      ],
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (kind, namespace, name, engine, outcome, reason, job_name) (label_replace(karkive_backup_last_job_duration_seconds{namespace=~\"$namespace\",engine=~\"$engine\"} * on(namespace,name,engine) group_left(outcome,reason,job_name) karkive_backup_last_job_info{namespace=~\"$namespace\",engine=~\"$engine\"}, \"kind\", \"Backup\", \"\", \"\")) or sum by (kind, namespace, name, engine, outcome, reason, job_name) (label_replace(karkive_restore_last_job_duration_seconds{namespace=~\"$namespace\",engine=~\"$engine\"} * on(namespace,name,engine) group_left(outcome,reason,job_name) karkive_restore_last_job_info{namespace=~\"$namespace\",engine=~\"$engine\"}, \"kind\", \"Restore\", \"\", \"\"))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (kind, namespace, name, engine, outcome, reason, job_name) (label_replace((time() - karkive_backup_last_successful_timestamp_seconds{namespace=~\"$namespace\",engine=~\"$engine\"}) * on(namespace,name,engine) group_left(outcome,reason,job_name) karkive_backup_last_job_info{namespace=~\"$namespace\",engine=~\"$engine\"}, \"kind\", \"Backup\", \"\", \"\")) or sum by (kind, namespace, name, engine, outcome, reason, job_name) (label_replace((time() - karkive_restore_last_successful_timestamp_seconds{namespace=~\"$namespace\",engine=~\"$engine\"}) * on(namespace,name,engine) group_left(outcome,reason,job_name) karkive_restore_last_job_info{namespace=~\"$namespace\",engine=~\"$engine\"}, \"kind\", \"Restore\", \"\", \"\"))",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "CRs that have never finished a Job. 0 when every CR has a last job.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 6, "x": 18, "y": 10 },
      "id": 14,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "No finished job",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(count(karkive_backup_ready{namespace=~\"$namespace\",engine=~\"$engine\"} unless on(namespace,name,engine) karkive_backup_last_job_info) or vector(0)) + (count(karkive_restore_ready{namespace=~\"$namespace\",engine=~\"$engine\"} unless on(namespace,name,engine) karkive_restore_last_job_info) or vector(0))",
          "legendFormat": "none",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 102,
      "title": "Trends",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Last job duration",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "karkive_backup_last_job_duration_seconds{namespace=~\"$namespace\",engine=~\"$engine\"}",
          "legendFormat": "Backup {{namespace}}/{{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "karkive_restore_last_job_duration_seconds{namespace=~\"$namespace\",engine=~\"$engine\"}",
          "legendFormat": "Restore {{namespace}}/{{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Dashed line is the 36h stale-backup alert.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 129600 }] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Time since last success",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - karkive_backup_last_successful_timestamp_seconds{namespace=~\"$namespace\",engine=~\"$engine\"}",
          "legendFormat": "Backup {{namespace}}/{{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - karkive_restore_last_successful_timestamp_seconds{namespace=~\"$namespace\",engine=~\"$engine\"}",
          "legendFormat": "Restore {{namespace}}/{{name}}",
          "refId": "B"
        }
      ]
    },
