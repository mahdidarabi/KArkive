{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "none" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Backups ready",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(karkive_backup_ready{namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "ready",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "none" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Restores ready",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(karkive_restore_ready{namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "ready",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }, { "color": "green", "value": 1 }] }, "unit": "none" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Last job succeeded",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(sum(karkive_backup_last_job_info{namespace=~\"$namespace\",outcome=\"Succeeded\"}) or vector(0)) + (sum(karkive_restore_last_job_info{namespace=~\"$namespace\",outcome=\"Succeeded\"}) or vector(0))",
          "legendFormat": "succeeded",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "none" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Last job failed",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(sum(karkive_backup_last_job_info{namespace=~\"$namespace\",outcome=\"Failed\"}) or vector(0)) + (sum(karkive_restore_last_job_info{namespace=~\"$namespace\",outcome=\"Failed\"}) or vector(0))",
          "legendFormat": "failed",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }, "unit": "none" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 9,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Suspended",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(sum(karkive_backup_suspended{namespace=~\"$namespace\"}) or vector(0)) + (sum(karkive_restore_suspended{namespace=~\"$namespace\"}) or vector(0))",
          "legendFormat": "suspended",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Oldest backup success age",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max((time() - karkive_backup_last_successful_timestamp_seconds{namespace=~\"$namespace\"}) and karkive_backup_suspended{namespace=~\"$namespace\"} == 0) or vector(0)",
          "legendFormat": "age",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "spanNulls": false }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Last job duration",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "karkive_backup_last_job_duration_seconds{namespace=~\"$namespace\"}",
          "legendFormat": "backup {{namespace}}/{{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "karkive_restore_last_job_duration_seconds{namespace=~\"$namespace\"}",
          "legendFormat": "restore {{namespace}}/{{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "spanNulls": false }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Time since last success",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - karkive_backup_last_successful_timestamp_seconds{namespace=~\"$namespace\"}",
          "legendFormat": "backup {{namespace}}/{{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - karkive_restore_last_successful_timestamp_seconds{namespace=~\"$namespace\"}",
          "legendFormat": "restore {{namespace}}/{{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [] },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Outcome" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "Failed": { "color": "red", "index": 0, "text": "Failed" },
                      "Succeeded": { "color": "green", "index": 1, "text": "Succeeded" },
                      "Unknown": { "color": "yellow", "index": 2, "text": "Unknown" }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true },
      "title": "Last job outcome",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true },
            "indexByName": {
              "kind": 0,
              "namespace": 1,
              "name": 2,
              "engine": 3,
              "outcome": 4,
              "reason": 5,
              "job_name": 6
            },
            "renameByName": {
              "kind": "Kind",
              "namespace": "Namespace",
              "name": "Name",
              "engine": "Engine",
              "outcome": "Outcome",
              "reason": "Reason",
              "job_name": "Job"
            }
          }
        }
      ],
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(karkive_backup_last_job_info{namespace=~\"$namespace\"}, \"kind\", \"Backup\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "backup",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(karkive_restore_last_job_info{namespace=~\"$namespace\"}, \"kind\", \"Restore\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "restore",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "unit": "s" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Kind" },
            "properties": [{ "id": "unit", "value": "string" }]
          },
          {
            "matcher": { "id": "byName", "options": "Namespace" },
            "properties": [{ "id": "unit", "value": "string" }]
          },
          {
            "matcher": { "id": "byName", "options": "Name" },
            "properties": [{ "id": "unit", "value": "string" }]
          },
          {
            "matcher": { "id": "byName", "options": "Engine" },
            "properties": [{ "id": "unit", "value": "string" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 11,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true },
      "title": "Last success age",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "indexByName": {
              "kind": 0,
              "namespace": 1,
              "name": 2,
              "engine": 3,
              "Value": 4
            },
            "renameByName": {
              "kind": "Kind",
              "namespace": "Namespace",
              "name": "Name",
              "engine": "Engine",
              "Value": "Age"
            }
          }
        }
      ],
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(time() - karkive_backup_last_successful_timestamp_seconds{namespace=~\"$namespace\"}, \"kind\", \"Backup\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "backup",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(time() - karkive_restore_last_successful_timestamp_seconds{namespace=~\"$namespace\"}, \"kind\", \"Restore\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "restore",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Reconcile errors",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (controller) (rate(controller_runtime_reconcile_errors_total{controller=~\"backup|restore\", namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{controller}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "unit": "s" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Kind" },
            "properties": [{ "id": "unit", "value": "string" }]
          },
          {
            "matcher": { "id": "byName", "options": "Namespace" },
            "properties": [{ "id": "unit", "value": "string" }]
          },
          {
            "matcher": { "id": "byName", "options": "Name" },
            "properties": [{ "id": "unit", "value": "string" }]
          },
          {
            "matcher": { "id": "byName", "options": "Engine" },
            "properties": [{ "id": "unit", "value": "string" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "id": 12,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true },
      "title": "Last schedule age",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "indexByName": {
              "kind": 0,
              "namespace": 1,
              "name": 2,
              "engine": 3,
              "Value": 4
            },
            "renameByName": {
              "kind": "Kind",
              "namespace": "Namespace",
              "name": "Name",
              "engine": "Engine",
              "Value": "Age"
            }
          }
        }
      ],
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(time() - karkive_backup_last_schedule_timestamp_seconds{namespace=~\"$namespace\"}, \"kind\", \"Backup\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "backup",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(time() - karkive_restore_last_schedule_timestamp_seconds{namespace=~\"$namespace\"}, \"kind\", \"Restore\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "restore",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["karkive"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({__name__=~\"karkive_(backup|restore)_ready\"}, namespace)",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
        "multi": false,
        "name": "namespace",
        "options": [],
        "query": "label_values({__name__=~\"karkive_(backup|restore)_ready\"}, namespace)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "KArkive",
  "uid": "karkive",
  "version": 2
}
